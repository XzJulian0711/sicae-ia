{
  "manifest_version": 3,
  "name": "SICAE-IA",
  "version": "0.9.0",
  "description": "Clasifica correos en legítimo, publicidad o phishing y les asigna prioridad (prototipo académico).",
  "key": "",
  "icons": {
    "16": "iconos/sicae-16.png",
    "32": "iconos/sicae-32.png",
    "48": "iconos/sicae-48.png",
    "128": "iconos/sicae-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "identity"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://127.0.0.1:8000/*",
    "https://oauth2.googleapis.com/*",
    "https://openidconnect.googleapis.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "402160823752-0k9972f1flplq91cul9j9rmhiu4v3osm.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "SICAE-IA",
    "default_icon": {
      "16": "iconos/sicae-16.png",
      "32": "iconos/sicae-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail/selectores.js", "gmail/lector.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "opciones/opciones.html",
    "open_in_tab": true
  }
}
