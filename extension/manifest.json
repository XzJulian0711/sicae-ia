{
  "manifest_version": 3,
  "name": "SICAE-IA",
  "version": "0.4.0",
  "description": "Clasifica correos en legítimo, publicidad o phishing y les asigna prioridad (prototipo académico).",
  "icons": {
    "16": "iconos/sicae-16.png",
    "32": "iconos/sicae-32.png",
    "48": "iconos/sicae-48.png",
    "128": "iconos/sicae-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://mail.google.com/*", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "SICAE-IA",
    "default_icon": {
      "16": "iconos/sicae-16.png",
      "32": "iconos/sicae-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail/selectores.js", "gmail/lector.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "opciones/opciones.html",
    "open_in_tab": true
  }
}
