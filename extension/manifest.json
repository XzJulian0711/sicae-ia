{
  "manifest_version": 3,
  "name": "SICAE-IA",
  "version": "0.1.0",
  "description": "Clasifica el correo abierto en legitimo, publicidad o phishing y le asigna una prioridad.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Abrir SICAE-IA"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  }
}
