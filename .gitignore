# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/
dist/
build/

# ---------- Secretos ----------
# .env lleva las claves reales y NUNCA se sube. La plantilla .env.example si.
.env
.env.*
!.env.example

# ---------- Datos crudos (pesados y pueden traer datos personales) ----------
# Se ignora el CONTENIDO, pero el .gitkeep conserva la carpeta al clonar.
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep

# ---------- Correos exportados de cuentas de prueba ----------
# Son correos reales: nunca se suben, esten en la carpeta que esten.
*.eml
*.msg
# Carpeta de correos para evaluar la regla de publicidad (paso 1.8): se ignora completa,
# para que tampoco se suba ningun otro archivo exportado junto a los .eml.
ml/data/eml/

# ---------- Modelos entrenados (se regeneran entrenando) ----------
ml/models/*.joblib

# ---------- Base de datos local (SQLite) ----------
*.db
*.sqlite3

# ---------- Logs ----------
*.log

# ---------- Editor / sistema operativo ----------
.vscode/
.idea/
.DS_Store
Thumbs.db