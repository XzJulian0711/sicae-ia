# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/
dist/
build/

# ---------- Secretos ----------
# .env lleva las claves reales y NUNCA se sube. La plantilla .env.example si.
.env
.env.*
!.env.example
# Clave PRIVADA de la extensión (paso 4.1) y extensiones empaquetadas (.crx, firmadas con ella).
# La privada vive fuera del repo; esto evita subirla por accidente. La PÚBLICA sí va en el
# manifest ("key"): es la que fija el ID.
*.pem
*.crx

# ---------- Datos crudos (pesados y pueden traer datos personales) ----------
# Se ignora el CONTENIDO, pero el .gitkeep conserva la carpeta al clonar.
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep

# ---------- Correos exportados de cuentas de prueba ----------
# Son correos reales: nunca se suben, esten en la carpeta que esten.
*.eml
*.msg
# Carpeta de correos para evaluar la regla de publicidad (paso 1.8): se ignora completa,
# para que tampoco se suba ningun otro archivo exportado junto a los .eml.
ml/data/eml/

# ---------- Configuracion personal ----------
# Copia local de ml/config/prioridad.json con remitentes y dominios reales de cada
# usuario. Si existe, se usa en lugar del de Git. Nunca se sube.
ml/config/prioridad.local.json

# ---------- Evaluación de la redacción con IA (paso 6.4) ----------
# Los borradores generados y la clave (código -> sistema) no se suben: la clave rompería la
# calificación a ciegas. SÍ se suben casos.csv (correos inventados), la plantilla
# calificacion.csv y el resumen en evaluacion/redaccion/reportes/ (solo números).
evaluacion/redaccion/resultados/

# ---------- Modelos entrenados (se regeneran entrenando) ----------
ml/models/*.joblib

# ---------- Base de datos local (SQLite) ----------
*.db
*.sqlite3
# Archivos auxiliares que SQLite crea junto a la base mientras escribe.
*.db-journal
*.db-wal
*.db-shm

# ---------- Logs ----------
*.log

# ---------- Editor / sistema operativo ----------
.vscode/
.idea/
.DS_Store
Thumbs.db