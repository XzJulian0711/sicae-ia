# Plantilla de variables de entorno de SICAE-IA.
#
# Copia este archivo como .env (que NO se sube a Git) y cambia lo que necesites.
# Si una variable comentada no está, la API usa el valor por defecto que se muestra aquí.
# Este archivo de ejemplo SÍ se sube a Git: nunca pongas aquí una clave real.
#
# Las rutas relativas se leen desde la carpeta donde arrancas uvicorn (la raíz del proyecto).

# ---------- Seguridad (obligatoria) ----------
# Clave que la extensión envía en el encabezado X-API-Key. Sin ella la API no arranca, y
# con el valor de ejemplo "cambia-esto" tampoco (salvo SICAE_MODO=desarrollo).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SICAE_API_KEY=cambia-esto

# Orígenes del navegador que pueden llamar a la API (CORS), separados por comas. Nunca "*".
# El ID de la extensión es fijo para todo el equipo (campo "key" del manifest, paso 4.1):
# SICAE_CORS_ORIGINS=chrome-extension://kaabamgfaihcpmchpeacpohpchlgildf

# Tamaño máximo de una petición en bytes (más grande = error 413).
# SICAE_MAX_BYTES=200000

# Peticiones por minuto por IP (más = error 429).
# SICAE_RATE_LIMIT=30

# "desarrollo" habilita /docs y /redoc; "produccion" los apaga.
# SICAE_MODO=produccion

# ---------- Registro de análisis ----------
# Base SQLite con una fila por análisis, sin texto del correo (fuera de Git).
# SICAE_DB_PATH=api/data/sicae.db

# ---------- Modelo v1.0 ----------
# SICAE_RUTA_MODELO=ml/models/clasificador.joblib
# SICAE_RUTA_UMBRAL=ml/reports/umbral_confianza.json
# SICAE_RUTA_PROMEDIOS=ml/reports/promedios_estructurales.json

# ---------- Prioridad ----------
# Déjala comentada para usar la de siempre: ml/config/prioridad.local.json si existe;
# si no, ml/config/prioridad.json. Descoméntala solo para apuntar a otro archivo.
# SICAE_RUTA_CONFIG_PRIORIDAD=ml/config/prioridad.local.json

# ---------- Límites de la entrada (más grande = error 422) ----------
# SICAE_MAX_ASUNTO=1000
# SICAE_MAX_CUERPO=50000
# SICAE_MAX_DESTINATARIOS=100
# SICAE_MAX_CABECERAS=100
# SICAE_MAX_VALOR_CABECERA=2000
